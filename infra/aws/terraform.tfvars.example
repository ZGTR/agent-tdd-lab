# Supply IDs from an existing private-network foundation.
region              = "us-east-1"
vpc_id              = "vpc-0123456789abcdef0"
subnet_ids          = ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]
allowed_https_cidrs = ["10.0.0.0/16"]
# Null bootstraps the repository. After pushing an image, set its digest:
# image_digest = "sha256:<64 lowercase hex characters>"
